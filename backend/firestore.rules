rules_version = '2';
// HopHop: istemciler Firestore'a ASLA doğrudan erişmez.
// Tüm okuma/yazma Vercel API'sindeki Admin SDK üzerinden yapılır
// (Admin SDK bu kurallardan muaftır). Bu kurallar her şeyi kapatır.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
