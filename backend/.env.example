# Vercel ortam değişkenleri (Vercel dashboard → Settings → Environment Variables)

# Kimlik hash'i için gizli tuz — üret: openssl rand -hex 32
PEPPER=

# Profil alanlarının AES-256-GCM anahtarı (32 bayt hex = 64 karakter) — üret: openssl rand -hex 32
PROFILE_KEY=

# Oturum JWT imza anahtarı — üret: openssl rand -hex 32
JWT_SECRET=

# Yönetici betiklerinin kullandığı gizli anahtar — üret: openssl rand -hex 32
ADMIN_SECRET=

# LiveKit Cloud → proje ayarlarından
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://<proje>.livekit.cloud

# Firebase → Project Settings → Service accounts → Generate new private key
# İndirilen JSON'u base64'e çevir: base64 -w0 service-account.json
FIREBASE_SERVICE_ACCOUNT=
