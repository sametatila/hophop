    ringtone       → gelen arama bildirim kanalının zil sesi
                     (RawResourceAndroidNotificationSound('ringtone')).
                     Silinince arama bildirimi SESSİZ geliyordu.

  Yeni bir kaynağa yalnızca Dart'tan atıf verirsen buraya eklemeyi unutma —
  debug derlemesinde sorun görünmez, yalnızca release'de patlar.
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/ic_stat_hophop,@raw/ringtone" />
